# Copy to .env for local use. Replace database credentials and the signing key.
# Demo credentials are intentionally public; keep API and Vite demo values in sync.
MYSQL_DATABASE=ems
MYSQL_USER=ems
MYSQL_PASSWORD=replace-with-a-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
MYSQL_URL=jdbc:mysql://localhost:3306/ems?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
EMS_JWT_SECRET=replace-with-base64-encoded-random-32-byte-secret
EMS_JWT_EXPIRATION_MS=28800000
EMS_CORS_ALLOWED_ORIGIN=http://localhost:5173
EMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
EMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-12-character-or-longer-password
EMS_DEMO_ACCOUNTS_ENABLED=true
EMS_DEMO_ADMIN_EMAIL=admin.demo@ems.test
EMS_DEMO_ADMIN_PASSWORD=DemoAdmin-2026!
EMS_DEMO_EMPLOYEE_EMAIL=employee.demo@ems.test
EMS_DEMO_EMPLOYEE_PASSWORD=DemoEmployee-2026!
EMS_DEMO_EMPLOYEE_NAME=Demo Employee

# These Vite values are embedded in the public frontend bundle by design.
VITE_API_BASE_URL=http://localhost:8080/api
VITE_DEMO_ADMIN_EMAIL=admin.demo@ems.test
VITE_DEMO_ADMIN_PASSWORD=DemoAdmin-2026!
VITE_DEMO_EMPLOYEE_EMAIL=employee.demo@ems.test
VITE_DEMO_EMPLOYEE_PASSWORD=DemoEmployee-2026!
